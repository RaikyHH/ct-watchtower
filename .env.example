# CT-Watchtower - an example configuration. Copy it to `.env` and set real values there.
# `.env` does not belong in the repository (see .gitignore and §14.5).
#
# Most of the values here can also be changed while running, under "Settings" in the
# interface - they take effect at once, without a restart. What is changed there lives
# in the database and trumps this file; "reset" throws that entry away, and afterwards
# what stands here holds again. So this file stays the base state a fresh container
# comes up on.

# ── Data handling ─────────────────────────────────────────────────────────────
DATABASE_PATH=ctwatchtower.sqlite3
RETENTION_DAYS=90

# ── Ingest (mode A: our own certstream-server-go, §3.1) ───────────────────────
# The public CaliDog endpoint is deliberately not the default - it was repeatedly
# unreachable over longer periods.
CERTSTREAM_URL=ws://127.0.0.1:8080/domains-only

# Deliberately without a contact and without an identity - the product name alone.
CT_USER_AGENT=CT-Watchtower
INGEST_QUEUE_SIZE=10000

# ── Deduplication (§3.4, §4.4) ────────────────────────────────────────────────
DEDUPE_CERT_TTL=21600
DEDUPE_FINDING_TTL=86400
# The rise in score from which an existing finding is reported again
RESCORE_DELTA=15

# ── Alerting (§8) ─────────────────────────────────────────────────────────────
# This goes to YOUR endpoint (Slack, Teams, a script of your own), not to someone
# else's service. Two conditions, not one: the switch AND a target. If one of them
# is missing, nothing happens, and the system screen says which one.
NOTIFY_ENABLED=false
NOTIFY_WEBHOOK_URL=
# Set → HMAC-SHA256 over the body in the header X-Watchtower-Signature
NOTIFY_SECRET=
NOTIFY_MIN_SEVERITY=warning
# The collecting window in seconds: one message instead of a hundred (§8.2.1)
NOTIFY_WINDOW=300
NOTIFY_MAX_PER_HOUR=12
# The same domain again after this many days at the earliest (§8.2.3)
NOTIFY_RENOTIFY_DAYS=7
NOTIFY_TIMEOUT=10

# ── Email (§8.1) ──────────────────────────────────────────────────────────────
# A second way of reporting beside the webhook, with the same brakes: the same
# aggregation, the same rate limiting, the same repeat suppression. NOTIFY_ENABLED
# is the main switch for both; MAIL_ENABLED adds this channel to it.
MAIL_ENABLED=false
MAIL_FROM=ct-watchtower@example.org
# Several recipients separated by commas
MAIL_TO=security@example.org

# smtp | http  - two ways, because one of them often does not work:
#   smtp  the obvious one. Many networks block ports 25, 465 and 587 though,
#         and home connections almost always do.
#   http  the same providers accept mail over their HTTPS interface.
#         Port 443 is open everywhere.
MAIL_TRANSPORT=smtp

# Way 1 - your own or a rented mail server (Hetzner, mailbox.org, Exchange ...)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# starttls (587) | ssl (465) | none (only for a relay in your own network)
MAIL_SMTP_SECURITY=starttls
# Leave empty when the relay accepts mail without a login
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# Way 2 - a provider's HTTPS interface, when the SMTP port is blocked.
# brevo | mailgun | mailgun_eu | postmark | resend | sendgrid
MAIL_HTTP_PROVIDER=
MAIL_HTTP_KEY=
# Mailgun only: the sender domain registered there
MAIL_HTTP_DOMAIN=

# ── Feeds (§10.2, §11) ────────────────────────────────────────────────────────
# The base URL for links in the feed and in reports, e.g. https://watchtower.internal
UI_BASE_URL=
INDICATOR_TTL_DAYS=90

# ── Enrichment (§7, §18.1) ────────────────────────────────────────────────────
# IMPORTANT: the enrichment queries other people's registries (RDAP and WHOIS) and
# DNS resolvers. Their terms allow single queries but forbid automated mass queries
# - Google Registry: "Don't access our RDAP Domain Database through the use of high
# volume, automated electronic processes"; EURid forbids extracting substantial
# parts of the WHOIS data (§16).
#
# Hence: off by default, and even when switched on nothing is **ever** enriched
# automatically - only on an explicit request for a single finding (the button in
# the detail panel). The daily caps below are a hard brake; they are counted in the
# database and survive a restart.
ENRICH_ENABLED=false
ENRICH_RDAP_ENABLED=true
# Requests/s per RDAP or WHOIS server; on an HTTP 429 the server rests for 10 min
ENRICH_RDAP_RPS=1
ENRICH_RDAP_DAILY=200
ENRICH_RDAP_DAILY_PER_SERVER=50
# Port 43 WHOIS for TLDs without RDAP (.cn, .eu, .io). The WHOIS terms are the most
# restrictive of all - it stays off until somebody deliberately needs it.
ENRICH_WHOIS_FALLBACK=false
ENRICH_WHOIS_DAILY=20
ENRICH_WHOIS_DAILY_PER_SERVER=10
ENRICH_DOH_ENABLED=true
ENRICH_DOH_PRIMARY=https://dns.google/resolve
ENRICH_DOH_FALLBACK=https://cloudflare-dns.com/dns-query
ENRICH_DOH_RPS=10
ENRICH_DOH_DAILY=2000
ENRICH_TIMEOUT=10
# The active modules (http_probe, favicon_hash, tls_probe, screenshot) make contact
# with the suspicious domain and make our own IP known. Not built; stays off.
ENRICH_ACTIVE_ENABLED=false
# Empty = VirusTotal as a deeplink button only (§7.7), no API call
VT_API_KEY=

# ── Setting off an analysis at an external scanner ────────────────────────────
# The one operation in which the suspicious page really is fetched - by the
# service, not by you. Your IP never touches it. Only at the press of a button,
# only for a single finding; there is no batch mode.
# Both services demand in their terms that you are allowed to scan the URL.
SCAN_ENABLED=false
# private | unlisted | public. `public` shows the page's operator within minutes
# that they were spotted. `private` needs a key at BOTH services.
SCAN_VISIBILITY=private
# A hard daily cap per service (a UTC day, it survives restarts)
SCAN_DAILY=25
# urlscan.io: a key is mandatory, even for public scans. Free: 50 private a day.
URLSCAN_API_KEY=
# scanmalware.com (Triop AB, Sweden): public and unlisted work without a key.
SCANMALWARE_API_KEY=

# ── The abuse report ──────────────────────────────────────────────────────────
# The language of the template under config/abuse_templates/<language>.txt. Unknown
# values fall back to `de`. Nothing is sent - the interface opens a draft.
ABUSE_LANGUAGE=de

# ── Going out through a proxy ─────────────────────────────────────────────────
# Set these if your network only reaches outwards through a proxy. The compose file
# hands each one to every container, in both spellings, because the tools disagree
# about which they read.
#
# What goes through it:
#   * RDAP, DoH and the scan services (httpx)
#   * Mozilla's OneCRL and the mail providers' HTTPS interfaces
#   * the certstream service's connections to the CT logs
#
# What does NOT, and cannot:
#   * WHOIS on port 43. That is a raw TCP connection, not HTTP, and an HTTP proxy
#     cannot carry it. In a network without direct outbound access leave
#     ENRICH_WHOIS_FALLBACK=false; RDAP covers most TLDs anyway.
#   * SMTP. Use MAIL_TRANSPORT=http with a provider instead, which goes over 443
#     and therefore through the proxy.
#
# `no_proxy` must name the neighbouring containers, otherwise a request to
# `certstream` is sent to a proxy that cannot reach it. Keep the cloud metadata
# address in the list as well: it must never leave through a proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,certstream,169.254.169.254

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Running in containers (docker-compose.yml) ────────────────────────────────
# In compose, CERTSTREAM_URL points at the certstream service and is set there:
# ws://certstream:8080/domains-only
# The app's host port; it is bound exclusively to 127.0.0.1 (§13.2).
APP_PORT=8000
# The published image and its tag. Leave IMAGE as it is to pull from the registry;
# `docker compose build` builds it locally under the same name.
IMAGE=ghcr.io/raikyhh/ct-watchtower
TAG=latest
# An optional bearer token for /api/v1 (empty = off). There is no login (§1.2) -
# whoever exposes the app puts a reverse proxy in front of it.
API_TOKEN=

# The nightly backup (the `backup` service in compose)
BACKUP_AT=03:00
BACKUP_KEEP=14

# Enrich by itself, for findings from the tenant's `thresholds.enrich_from` upwards.
# Without this the campaigns stay empty - they bundle by registrar, nameserver and
# network, and those are enriched details. A switch of its own, because the
# threshold stands in every ruleset: otherwise an existing installation would start
# asking by itself at the next start. The daily caps above stay the hard brake.
ENRICH_AUTO=false

# ── Revoked CA certificates (§revocation list) ────────────────────────────────
# This fetches Mozilla's OneCRL - the same revocation list Firefox uses. Public
# infrastructure that millions of browsers draw from; one fetch a day is nothing
# against that, and with an ETag the normal case is a 304 with no payload.
# Off by default: it is the only fetch to the outside that happens without a click.
REVOCATION_ENABLED=false
REVOCATION_INTERVAL_HOURS=24
